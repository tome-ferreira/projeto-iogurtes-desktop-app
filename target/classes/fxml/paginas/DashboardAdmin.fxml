<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.LineChart?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.DashboardAdmin">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <StackPane fx:id="rootStack">
            <VBox spacing="32">
                <stylesheets>
                    <String fx:value="/styles/dashboardAdmin.css"/>
                </stylesheets>
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <Label fx:id="greetingLabel" styleClass="title-2"/>

                <HBox spacing="16" maxWidth="Infinity">
                    <!-- Admins -->
                    <VBox styleClass="stat-card, stat-card-admin" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavigateToUtilizadores">
                        <Label text="Admins" styleClass="role-title"/>
                        <Label fx:id="countAdmin" text="..." styleClass="role-count"/>
                        <ProgressIndicator fx:id="loadingAdmin" styleClass="loading-spinner"/>
                    </VBox>

                    <!-- Gestores -->
                    <VBox styleClass="stat-card, stat-card-gestor" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavigateToUtilizadores">
                        <Label text="Gestores" styleClass="role-title"/>
                        <Label fx:id="countGestor" text="..." styleClass="role-count"/>
                        <ProgressIndicator fx:id="loadingGestor" styleClass="loading-spinner"/>
                    </VBox>

                    <!-- Funcionários MP -->
                    <VBox styleClass="stat-card, stat-card-funcionario-mp" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavigateToUtilizadores">
                        <Label text="Funcionários MP" styleClass="role-title"/>
                        <Label fx:id="countFuncionarioMp" text="..." styleClass="role-count"/>
                        <ProgressIndicator fx:id="loadingFuncionarioMp" styleClass="loading-spinner"/>
                    </VBox>

                    <!-- Funcionários OP -->
                    <VBox styleClass="stat-card, stat-card-funcionario-op" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavigateToUtilizadores">
                        <Label text="Funcionários OP" styleClass="role-title"/>
                        <Label fx:id="countFuncionarioOp" text="..." styleClass="role-count"/>
                        <ProgressIndicator fx:id="loadingFuncionarioOp" styleClass="loading-spinner"/>
                    </VBox>

                    <!-- Clientes -->
                    <VBox styleClass="stat-card, stat-card-cliente" HBox.hgrow="ALWAYS" onMouseClicked="#handleNavigateToUtilizadores">
                        <Label text="Clientes" styleClass="role-title"/>
                        <Label fx:id="countCliente" text="..." styleClass="role-count"/>
                        <ProgressIndicator fx:id="loadingCliente" styleClass="loading-spinner"/>
                    </VBox>
                </HBox>

                <HBox spacing="16" HBox.hgrow="ALWAYS">
                    <!-- Pie chart card: 60% width -->
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS"
                          prefWidth="0" minHeight="280" fx:id="pieChartCard"
                          onMouseClicked="#handleNavigateToEncomendas">
                        <Label text="Encomendas por Estado" styleClass="card-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <ProgressIndicator fx:id="loadingEncomendas"/>
                            <PieChart fx:id="pieChartEncomendas"
                                      prefHeight="260"
                                      labelsVisible="true"
                                      legendVisible="true"
                                      legendSide="RIGHT"/>
                        </StackPane>
                    </VBox>

                    <!-- Quick actions card: 40% width -->
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS"
                          prefWidth="0" minHeight="280" maxWidth="400">
                        <Label text="Ações Rápidas" styleClass="card-title"/>
                        <VBox spacing="12" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                            <padding><Insets top="16"/></padding>
                            <Button text="Gerir Produtos" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToProdutosFinais"/>
                            <Button text="Gerir Utilizadores" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToUtilizadores"/>
                            <Button text="Gerir Fornecedores" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToFornecedores"/>
                            <Button text="Gerir Matérias Primas" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToMateriasPrimas"/>
                        </VBox>
                    </VBox>
                </HBox>
                <HBox spacing="16" HBox.hgrow="ALWAYS" minHeight="280">
                    <!-- Bar chart card: 60% width -->
                    <VBox fx:id="barChartCard" styleClass="dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="Produtos Mais Vendidos" styleClass="card-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <ProgressIndicator fx:id="loadingBarChart"/>
                            <BarChart fx:id="barChartProdutos" prefHeight="240"
                                      animated="false" legendVisible="false">
                                <xAxis>
                                    <CategoryAxis label="Produto"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Encomendas Expedidas" lowerBound="0" autoRanging="true"/>
                                </yAxis>
                            </BarChart>
                        </StackPane>
                    </VBox>

                    <!-- Pie chart matérias -->
                    <VBox fx:id="pieChartMateriasCard" styleClass="dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="Matérias Primas por Tipo" styleClass="card-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <ProgressIndicator fx:id="loadingPieChartMaterias"/>
                            <PieChart fx:id="pieChartMaterias" prefHeight="240"
                                      labelsVisible="true" legendVisible="true" legendSide="RIGHT"/>
                        </StackPane>
                    </VBox>

                    <!-- Line chart ordens -->
                    <VBox fx:id="lineChartOrdensCard" styleClass="dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0" onMouseClicked="#handleNavigateToOrdensProducao">
                        <Label text="Ordens Concluídas (últimos 5 dias)" styleClass="card-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <ProgressIndicator fx:id="loadingLineChartOrdens"/>
                            <LineChart fx:id="lineChartOrdens" prefHeight="240"
                                       animated="false" legendVisible="false">
                                <xAxis>
                                    <CategoryAxis label="Dia"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Ordens Concluídas" lowerBound="0" autoRanging="true"/>
                                </yAxis>
                            </LineChart>
                        </StackPane>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
