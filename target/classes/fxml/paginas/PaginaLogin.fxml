<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.controllers.PaginaLogin"
      spacing="12" alignment="CENTER">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="Norgurtes" styleClass="title-1"/>
    <Label text="Inicia sessão para continuar" styleClass="text-muted"/>

    <TextField fx:id="campoEmail" promptText="Email" maxWidth="300"/>
    <PasswordField fx:id="campoPassword" promptText="Palavra-passe" maxWidth="300"/>

    <!-- Área de erro — visível apenas quando o login falha -->
    <Label fx:id="lblErro"
           styleClass="danger"
           wrapText="true"
           maxWidth="300"
           visible="false"
           managed="false"/>

    <Button fx:id="btnEntrar" text="Entrar" maxWidth="300"
            styleClass="button-outlined, accent"
            onAction="#handleLogin"/>

</VBox>
