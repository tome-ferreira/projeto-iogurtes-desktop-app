<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.OrdensProducaoController">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="pagina-conteudo" VBox.vgrow="ALWAYS">
            <stylesheets>
                <String fx:value="/styles/ordemProducao.css"/>
            </stylesheets>

            <!--  Header -->
            <HBox styleClass="pagina-cabecalho" maxWidth="Infinity">
                <Label text="Ordens de Produção" styleClass="pagina-titulo"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNovo" text="Nova Ordem"
                        textFill="WHITE" styleClass="btn-primario-cabecalho"
                        onAction="#handleNovo">
                    <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="16"/></graphic>
                </Button>
            </HBox>

            <HBox styleClass="pagina-separador">
                <Region style="-fx-background-color: -color-border-default; -fx-pref-height: 1;"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <StackPane fx:id="rootStack" VBox.vgrow="ALWAYS">
                <VBox VBox.vgrow="ALWAYS">
                    <padding><Insets top="0" right="32" bottom="32" left="32"/></padding>

                    <!-- Filtro + Paginação -->
                    <HBox styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"/>

                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Estado:" styleClass="pagination-label"/>
                            <ComboBox fx:id="cbFiltroEstado" styleClass="pagination-combo"
                                      promptText="Todos os Estados"/>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="btnAnterior" text="Anterior" onAction="#handlePaginaAnterior"
                                    styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="18"/></graphic>
                            </Button>
                            <Label text="Linhas por página:" styleClass="pagination-label"/>
                            <ComboBox fx:id="cbTamanhoPagina" styleClass="pagination-combo"/>
                            <Button fx:id="btnProxima" text="Próximo" contentDisplay="RIGHT"
                                    onAction="#handleProximaPagina" styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="18"/></graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- TableView VBox -->
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="tabelaContainer" styleClass="tabela-card" fillWidth="true"/>
                    </ScrollPane>
                </VBox>

                <!-- Overlay de loading -->
                <VBox fx:id="loadingOverlay" styleClass="loading-overlay"
                      alignment="CENTER" visible="false" managed="false">
                    <ProgressIndicator styleClass="loading-spinner"/>
                    <Label text="A carregar ordens de produção..." styleClass="loading-label"/>
                </VBox>
                
                <!-- FAB -->

            </StackPane>
        </VBox>
    </center>
</BorderPane>
