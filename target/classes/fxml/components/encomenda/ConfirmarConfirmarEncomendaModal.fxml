<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.encomenda.ConfirmarConfirmarEncomendaModalController"
      styleClass="modal-root" prefWidth="440">

    <stylesheets>
        <String fx:value="/styles/encomenda.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Confirmar Encomenda" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2c-check-circle-outline" iconSize="48" styleClass="estado-expedida"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="form-label"
               text="Tem a certeza que pretende confirmar esta encomenda?"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="celula-dados"
               text="Isto irá processar a encomenda para expedição."/>
        
        <VBox fx:id="erroContainer" visible="false" managed="false" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <ScrollPane fitToWidth="true" minHeight="80" maxHeight="200" style="-fx-background-color: transparent; -fx-background: transparent;">
                <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"/>
            </ScrollPane>
        </VBox>
    </VBox>

    <HBox styleClass="modal-footer" spacing="12">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" styleClass="btn-secundario"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfirmar" text="Confirmar Encomenda" onAction="#handleConfirmar" styleClass="button, accent"/>
    </HBox>

</VBox>
