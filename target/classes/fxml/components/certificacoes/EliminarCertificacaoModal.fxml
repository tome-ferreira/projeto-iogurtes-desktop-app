<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.certificacoes.EliminarCertificacaoModalController"
      styleClass="modal-root" prefWidth="450">

    <stylesheets>
        <String fx:value="/styles/certificacoes.css"/>
    </stylesheets>

    <!-- Cabeçalho -->
    <HBox styleClass="modal-header">
        <Label text="Eliminar Certificação" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content">
        <Label fx:id="lblMensagem" wrapText="true" styleClass="form-label"/>
        <Label fx:id="erroFeedback" styleClass="form-error"/>
    </VBox>

    <!-- Rodapé -->
    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" defaultButton="true" onAction="#handleCancelar"
                styleClass="btn-modal-cancel"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar"
                styleClass="btn-modal-submit-danger"/>
    </HBox>

</VBox>
