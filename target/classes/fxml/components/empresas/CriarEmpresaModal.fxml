<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.empresas.CriarEmpresaModalController"
      styleClass="modal-root" prefWidth="500">

    <stylesheets>
        <String fx:value="/styles/empresas.css"/>
    </stylesheets>

    <!-- Cabeçalho -->
    <HBox styleClass="modal-header">
        <Label text="Nova Empresa" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content">

        <!-- Linha 1: Nome e NIPC -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Nome da empresa*" styleClass="form-label"/>
                <TextField fx:id="txtNome" styleClass="form-control" promptText="Nome da empresa"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="NIPC*" styleClass="form-label"/>
                <TextField fx:id="txtNipc" styleClass="form-control" promptText="123456789"/>
            </VBox>
        </HBox>

        <!-- Linha 2: Telefone e Morada -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Telefone" styleClass="form-label"/>
                <TextField fx:id="txtTelefone" styleClass="form-control" promptText="+351 210 000 000"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Morada*" styleClass="form-label"/>
                <TextField fx:id="txtMorada" styleClass="form-control" promptText="Rua Exemplo, 123"/>
            </VBox>
        </HBox>

        <!-- Linha 3: Código Postal e Cidade -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Código postal*" styleClass="form-label"/>
                <TextField fx:id="txtCp" styleClass="form-control" promptText="1000-001"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Cidade*" styleClass="form-label"/>
                <TextField fx:id="txtCidade" styleClass="form-control" promptText="Lisboa"/>
            </VBox>
        </HBox>

        <Label fx:id="lblErro" styleClass="form-error" wrapText="true"/>
    </VBox>

    <!-- Rodapé -->
    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#handleCancelar"
                styleClass="btn-modal-cancel"/>
        <Button fx:id="btnCriar" text="Criar Empresa" defaultButton="true" onAction="#handleCriar"
                styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
