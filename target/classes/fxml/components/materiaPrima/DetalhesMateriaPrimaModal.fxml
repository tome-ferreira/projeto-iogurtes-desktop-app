<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.materiaPrima.DetalhesMateriaPrimaModalController"
      styleClass="modal-root" prefWidth="450">

    <stylesheets>
        <java.lang.String fx:value="/styles/materiaPrima.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Detalhes da Matéria Prima" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content">
        <VBox styleClass="form-group">
            <Label text="Nome" styleClass="form-label"/>
            <TextField fx:id="txtNome" editable="false" styleClass="form-control"/>
        </VBox>

        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Unidade" styleClass="form-label"/>
                <TextField fx:id="txtUnidade" editable="false" styleClass="form-control"/>
            </VBox>
            
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Estado" styleClass="form-label"/>
                <TextField fx:id="txtEstado" editable="false" styleClass="form-control"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Stock Mínimo" styleClass="form-label"/>
                <TextField fx:id="txtStockMinimo" editable="false" styleClass="form-control"/>
            </VBox>

            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Stock Atual" styleClass="form-label"/>
                <TextField fx:id="txtStockAtual" editable="false" styleClass="form-control"/>
            </VBox>
        </HBox>

        <VBox styleClass="form-group">
            <Label text="Tipo de Matéria Prima" styleClass="form-label"/>
            <TextField fx:id="txtTipo" editable="false" styleClass="form-control"/>
        </VBox>

    </VBox>

    <HBox styleClass="modal-footer">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
