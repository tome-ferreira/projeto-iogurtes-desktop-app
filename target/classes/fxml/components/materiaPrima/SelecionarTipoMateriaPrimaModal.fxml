<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.materiaPrima.SelecionarTipoMateriaPrimaModalController"
      styleClass="modal-root" prefWidth="480" prefHeight="550">

    <stylesheets>
        <java.lang.String fx:value="/styles/materiaPrima.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Selecione o Tipo de Matéria Prima" styleClass="modal-title"/>
    </HBox>

    <!-- Lista com Scroll -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox fx:id="listaContainer" styleClass="modal-content" spacing="0">
            <!-- Linhas inseridas dinamicamente pelo controller -->
        </VBox>
    </ScrollPane>

    <!-- Footer: Paginação e Loading -->
    <VBox spacing="16" styleClass="modal-footer">
        
        <!-- Estado de Loading (oculto por omissão) -->
        <HBox fx:id="hboxLoading" alignment="CENTER" spacing="10" visible="false" managed="false">
            <ProgressIndicator prefWidth="20" prefHeight="20"/>
            <Label text="A carregar tipos..." textFill="#6c757d"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <!-- Paginação -->
            <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAnterior" text="Anterior" onAction="#handleAnterior" styleClass="btn-pagination">
                <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="18"/></graphic>
            </Button>
            <Button fx:id="btnProximo" text="Próximo" onAction="#handleProximo" styleClass="btn-pagination" contentDisplay="RIGHT">
                <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="18"/></graphic>
            </Button>
        </HBox>

        <!-- Botões de Ação -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button text="Continuar" fx:id="btnContinuar" onAction="#handleContinuar" styleClass="btn-modal-submit"/>
        </HBox>
    </VBox>

</VBox>
