<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.materiaPrima.FornecedoresEmBreveModalController"
      styleClass="modal-root" prefWidth="350">

    <stylesheets>
        <java.lang.String fx:value="/styles/materiaPrima.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Informação" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2i-information-outline" iconSize="48" styleClass="estado-vazio-icone"/>
        <Label text="Gestão de fornecedores de matéria prima ainda não está disponível." 
               styleClass="form-label" wrapText="true" textAlignment="CENTER"/>
    </VBox>

    <HBox styleClass="modal-footer">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
