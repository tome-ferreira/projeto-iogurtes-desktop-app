<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.fornecedorestipo.EliminarFornecedorTipoModalController"
      styleClass="modal-root" prefWidth="450">

    <stylesheets>
        <String fx:value="/styles/fornecedorestipo.css"/>
    </stylesheets>

    <!-- Cabeçalho -->
    <HBox styleClass="modal-header">
        <Label text="Confirmar Eliminação" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content" spacing="16" alignment="CENTER">

        <FontIcon iconLiteral="mdi2a-alert-circle-outline" iconSize="48" styleClass="icone-alerta-eliminar" />

        <Label fx:id="lblAviso" styleClass="texto-aviso-eliminar" textAlignment="CENTER" wrapText="true"/>

        <Label fx:id="lblErro" styleClass="form-error" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <!-- Rodapé -->
    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#handleCancelar"
                styleClass="btn-modal-cancel"/>
        <Button fx:id="btnEliminar" text="Eliminar" defaultButton="true" onAction="#handleEliminar"
                styleClass="btn-modal-danger"/>
    </HBox>

</VBox>
