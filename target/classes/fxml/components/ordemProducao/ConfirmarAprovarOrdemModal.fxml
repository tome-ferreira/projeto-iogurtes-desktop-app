<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.ordemProducao.ConfirmarAprovarOrdemModalController"
      styleClass="modal-root" prefWidth="420">

    <stylesheets>
        <String fx:value="/styles/ordemProducao.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Aprovar Ordem de Produção" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2c-check-circle-outline" iconSize="48" styleClass="confirmar-icone-sucesso"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="confirmar-mensagem"
               text="Tem a certeza que pretende aprovar esta ordem de produção? Esta ação irá iniciar o processo de produção."/>
        <ScrollPane fx:id="scrollErro" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    maxHeight="150" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                    visible="false" managed="false">
            <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true" maxWidth="Infinity"/>
        </ScrollPane>
    </VBox>

    <HBox styleClass="modal-footer" spacing="12">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfirmar" text="Aprovar" onAction="#handleConfirmar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
