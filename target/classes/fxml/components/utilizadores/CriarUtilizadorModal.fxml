<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.utilizadores.CriarUtilizadorModalController"
      styleClass="modal-root" prefWidth="500">

    <stylesheets>
        <String fx:value="/styles/utilizadores.css"/>
    </stylesheets>

    <!-- Cabeçalho -->
    <HBox styleClass="modal-header">
        <Label text="Novo Utilizador" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content">

        <!-- Linha 1: Nome e Email -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Nome*" styleClass="form-label"/>
                <TextField fx:id="txtNome" styleClass="form-control" promptText="Nome completo"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="E-mail*" styleClass="form-label"/>
                <TextField fx:id="txtEmail" styleClass="form-control" promptText="exemplo@gestao.pt"/>
            </VBox>
        </HBox>

        <!-- Linha 2: Password e Turno -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Password inicial*" styleClass="form-label"/>
                <PasswordField fx:id="txtPassword" styleClass="form-control"/>
            </VBox>
            <VBox fx:id="boxTurno" styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Turno*" styleClass="form-label"/>
                <ComboBox fx:id="comboTurno" styleClass="form-control" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <!-- Linha 3: Admissão -->
        <VBox fx:id="boxAdmissao" styleClass="form-group">
            <Label text="Data de Admissão" styleClass="form-label"/>
            <DatePicker fx:id="dateAdmissao" styleClass="form-control" maxWidth="Infinity"/>
        </VBox>

        <!-- Role -->
        <VBox styleClass="form-group">
            <Label text="Papel (Role)*" styleClass="form-label"/>
            <ComboBox fx:id="comboRole" styleClass="form-control" maxWidth="Infinity"/>
        </VBox>

        <!-- Empresa (Apenas se role = CLIENTE_EMPRESA) -->
        <VBox fx:id="boxEmpresa" styleClass="form-group" managed="false" visible="false">
            <Label text="Empresa*" styleClass="form-label"/>
            <ComboBox fx:id="comboEmpresa" styleClass="form-control" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="lblErro" styleClass="form-error" managed="false" visible="false"/>
    </VBox>

    <!-- Rodapé -->
    <HBox styleClass="modal-footer">
        <Button text="Cancelar" cancelButton="true" onAction="#handleCancelar"
                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: -color-fg-muted;"/>
        <Button text="Criar Utilizador" defaultButton="true" onAction="#handleCriar"
                style="-fx-background-color: -color-accent-emphasis; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
    </HBox>

</VBox>
