<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.moeda.CriarMoedaModalController"
      styleClass="modal-root" prefWidth="500">

    <stylesheets>
        <String fx:value="/styles/moeda.css"/>
    </stylesheets>

    <!-- Cabeçalho -->
    <HBox styleClass="modal-header">
        <Label text="Nova Moeda" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content">
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Código ISO*" styleClass="form-label"/>
                <TextField fx:id="txtCodigo" styleClass="form-control" promptText="USD"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Nome*" styleClass="form-label"/>
                <TextField fx:id="txtNome" styleClass="form-control" promptText="Dólar Americano"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Símbolo*" styleClass="form-label"/>
                <TextField fx:id="txtSimbolo" styleClass="form-control" promptText="\$"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Taxa Conversão (EUR)*" styleClass="form-label"/>
                <TextField fx:id="txtTaxaConversaoEur" styleClass="form-control" promptText="0.92"/>
            </VBox>
        </HBox>

        <Label fx:id="lblErro" styleClass="form-error" wrapText="true" visible="true" managed="true" minHeight="32"/>
    </VBox>

    <!-- Rodapé -->
    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#handleCancelar"
                styleClass="btn-modal-cancel"/>
        <Button fx:id="btnCriar" text="Criar Moeda" defaultButton="true" onAction="#handleCriar"
                styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
