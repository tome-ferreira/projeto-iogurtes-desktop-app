<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.produtoFinal.SelecionarMateriaPrimaComposicaoModalController"
      styleClass="modal-root" prefWidth="500" prefHeight="550">

    <stylesheets>
        <java.lang.String fx:value="/styles/produtoFinal.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Adicionar Matéria Prima" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-padding: 24 24 0 24;">

        <!-- Controles de paginação -->
        <HBox styleClass="selecionar-tipo-pagination" alignment="CENTER" spacing="12">
            <Button fx:id="btnAnterior" text="Anterior" onAction="#handleAnterior"
                    styleClass="btn-pagination" disable="true"/>
            <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"
                   HBox.hgrow="ALWAYS" alignment="CENTER"/>
            <Button fx:id="btnProximo" text="Próximo" onAction="#handleProximo"
                    styleClass="btn-pagination"/>
        </HBox>

        <!-- Indicador de loading inline -->
        <HBox fx:id="hboxLoading" styleClass="selecionar-tipo-loading"
              alignment="CENTER" spacing="8" visible="false" managed="false">
            <ProgressIndicator styleClass="loading-spinner" prefWidth="24" prefHeight="24"/>
            <Label text="A carregar..." styleClass="loading-label"/>
        </HBox>

        <!-- Lista de matérias primas em ScrollPane restrito -->
        <ScrollPane prefHeight="280" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="listaContainer" styleClass="selecionar-tipo-lista" spacing="0"/>
        </ScrollPane>

        <!-- Secção de quantidade — sempre visível, com padding extra para não colar no scroll -->
        <VBox styleClass="quantidade-section" spacing="4" style="-fx-padding: 12 0 24 0;">
            <Label text="Quantidade por Unidade de Produto" styleClass="form-label"/>
            <TextField fx:id="txtQuantidade" promptText="ex: 0.25" styleClass="form-control"/>
            <!-- Erro inline da quantidade — espaço reservado, sempre presente -->
            <Label fx:id="lblQuantidadeErro" styleClass="quantidade-error" text="" wrapText="true"/>
        </VBox>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnAdicionar" text="Adicionar" defaultButton="true"
                onAction="#handleAdicionar" styleClass="btn-modal-submit" disable="true"/>
    </HBox>
</VBox>
