<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="modal-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestaoiogurtes.components.produtoFinal.ComposicaoProdutoFinalModalController">

    <stylesheets>
        <java.lang.String fx:value="/styles/produtoFinal.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Composição do Produto" styleClass="modal-title"/>
    </HBox>

    <!-- Content -->
    <VBox styleClass="modal-content" spacing="16" alignment="CENTER" VBox.vgrow="ALWAYS">
        <FontIcon iconLiteral="mdi2i-information-outline" iconSize="48" styleClass="estado-vazio-icone" iconColor="#1976d2"/>
        <Label styleClass="estado-vazio-titulo" textAlignment="CENTER" wrapText="true" text="Gestão da composição do produto final será implementada numa fase futura."/>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-cancel"/>
    </HBox>

</VBox>
