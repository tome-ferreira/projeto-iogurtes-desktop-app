<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.produtoFinal.ComposicaoModalController"
      styleClass="modal-root" prefWidth="600" prefHeight="500">

    <stylesheets>
        <java.lang.String fx:value="/styles/produtoFinal.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label fx:id="lblTitulo" text="Composição" styleClass="modal-title"/>
    </HBox>

    <!-- Toolbar: Novo botão -->
    <HBox styleClass="cert-toolbar" alignment="CENTER_RIGHT">
        <padding><Insets top="16" right="24" bottom="8" left="24"/></padding>
        <Button text="Adicionar Matéria Prima" onAction="#handleAdicionarNova" styleClass="btn-primario-cabecalho">
            <graphic>
                <FontIcon iconLiteral="mdi2p-plus" iconSize="18" styleClass="btn-icone"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Loading -->
    <HBox fx:id="hboxLoading" styleClass="cert-loading" alignment="CENTER" spacing="8" visible="false" managed="false">
        <ProgressIndicator styleClass="loading-spinner" prefWidth="24" prefHeight="24"/>
        <Label text="A carregar composição..." styleClass="loading-label"/>
    </HBox>

    <!-- Lista -->
    <VBox VBox.vgrow="ALWAYS">
        <padding><Insets top="8" right="24" bottom="24" left="24"/></padding>
        <VBox styleClass="tabela-card" VBox.vgrow="ALWAYS">
            
            <!-- Table Header -->
            <HBox styleClass="tabela-header">
                <Label text="NOME" styleClass="tabela-header-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="QUANTIDADE" styleClass="tabela-header-label" prefWidth="120"/>
                <Label text="REMOVER" styleClass="tabela-header-label" prefWidth="90" alignment="CENTER"/>
            </HBox>

            <!-- Table Body com Scroll -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="cert-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="listaContainer" VBox.vgrow="ALWAYS" spacing="0"/>
            </ScrollPane>
        </VBox>
    </VBox>


    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-cancel"/>
    </HBox>
</VBox>
