{
  "FornecedorResponse": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "nome": {
        "type": "string"
      },
      "nif": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "telefone": {
        "type": "string"
      },
      "morada": {
        "type": "string"
      },
      "cidade": {
        "type": "string"
      },
      "tipo": {
        "$ref": "#/components/schemas/FornecedorTipoResponse"
      },
      "certificacoes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FornecedorCertificacaoResponse"
        }
      },
      "isActive": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "CreateFornecedorRequest": {
    "type": "object",
    "properties": {
      "nome": {
        "type": "string",
        "maxLength": 150,
        "minLength": 2
      },
      "nif": {
        "type": "string",
        "pattern": "^\\d{9}$"
      },
      "email": {
        "type": "string"
      },
      "telefone": {
        "type": "string"
      },
      "morada": {
        "type": "string",
        "maxLength": 200,
        "minLength": 0
      },
      "cidade": {
        "type": "string",
        "maxLength": 100,
        "minLength": 0
      },
      "tipoId": {
        "type": "string",
        "format": "uuid"
      },
      "certificacoes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AddCertificacaoRequest"
        }
      }
    },
    "required": [
      "nif",
      "nome",
      "telefone"
    ]
  },
  "UpdateFornecedorRequest": {
    "type": "object",
    "properties": {
      "nome": {
        "type": "string",
        "maxLength": 150,
        "minLength": 2
      },
      "nif": {
        "type": "string",
        "pattern": "^\\d{9}$"
      },
      "email": {
        "type": "string"
      },
      "telefone": {
        "type": "string"
      },
      "morada": {
        "type": "string",
        "maxLength": 200,
        "minLength": 0
      },
      "cidade": {
        "type": "string",
        "maxLength": 100,
        "minLength": 0
      },
      "tipoId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "nif",
      "nome",
      "telefone"
    ]
  },
  "FornecedorTipoResponse": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "nome": {
        "type": "string"
      },
      "descricao": {
        "type": "string"
      },
      "isActive": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}