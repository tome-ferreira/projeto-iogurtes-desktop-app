<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.produtoFinal.CriarProdutoFinalModalController"
      styleClass="modal-root" prefWidth="650" prefHeight="650">

    <stylesheets>
        <java.lang.String fx:value="/styles/produtoFinal.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Criar Produto Final" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo em scroll principal -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="modal-content" spacing="12">

            <!-- Nome -->
            <VBox styleClass="form-group">
                <Label text="Nome*" styleClass="form-label"/>
                <TextField fx:id="txtNome" promptText="Nome do produto (2-120 caracteres)" styleClass="form-control"/>
            </VBox>

            <!-- Descrição -->
            <VBox styleClass="form-group">
                <Label text="Descrição" styleClass="form-label"/>
                <TextField fx:id="txtDescricao" promptText="Descrição opcional" styleClass="form-control"/>
            </VBox>

            <!-- Abreviação Sabor -->
            <VBox styleClass="form-group">
                <Label text="Abreviação Sabor* (3 letras)" styleClass="form-label"/>
                <TextField fx:id="txtAbreviacaoSabor" promptText="ex: MOR" styleClass="form-control"/>
            </VBox>

            <!-- Estado Físico -->
            <VBox styleClass="form-group">
                <Label text="Estado Físico*" styleClass="form-label"/>
                <ComboBox fx:id="cbEstadoFisico" styleClass="form-control" maxWidth="Infinity"/>
            </VBox>

            <!-- Validade Dias -->
            <VBox styleClass="form-group">
                <Label text="Validade (dias)" styleClass="form-label"/>
                <TextField fx:id="txtValidadeDias" promptText="ex: 30" styleClass="form-control"/>
            </VBox>

            <!-- Preço Venda -->
            <VBox styleClass="form-group">
                <Label text="Preço de Venda (€)" styleClass="form-label"/>
                <TextField fx:id="txtPrecoVenda" promptText="ex: 1.99" styleClass="form-control"/>
            </VBox>

            <!-- Preço por Kg -->
            <VBox styleClass="form-group">
                <Label text="Preço por Kg (€)" styleClass="form-label"/>
                <TextField fx:id="txtPrecoPorKg" promptText="ex: 3.50" styleClass="form-control"/>
            </VBox>

            <!-- Taxa IVA -->
            <VBox styleClass="form-group">
                <Label text="Taxa IVA* (%)" styleClass="form-label"/>
                <TextField fx:id="txtTaxaIva" promptText="ex: 23.0" styleClass="form-control"/>
            </VBox>

            <!-- Quantidade Lote -->
            <VBox styleClass="form-group">
                <Label text="Quantidade Lote*" styleClass="form-label"/>
                <TextField fx:id="txtQuantidadeLote" promptText="ex: 100" styleClass="form-control"/>
            </VBox>

            <!-- Visível ao Cliente -->
            <VBox styleClass="form-group">
                <Label text="Visível ao Cliente*" styleClass="form-label"/>
                <CheckBox fx:id="chkVisivelCliente" text="Produto visível no catálogo do cliente" styleClass="form-checkbox"/>
            </VBox>

            <!-- ── Composição ──────────────────────────────── -->
            <VBox spacing="4">
                <HBox styleClass="composicao-section-header" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Composição" styleClass="composicao-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="+ Adicionar Matéria Prima" onAction="#handleAdicionarMateria" styleClass="btn-adicionar-materia"/>
                </HBox>

                <!-- Aviso duplicado -->
                <Label fx:id="lblComposicaoAviso" styleClass="composicao-aviso" text="" wrapText="true" managed="false" visible="false"/>

                <!-- ScrollPane restrito para a lista de matérias -->
                <ScrollPane maxHeight="180" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="composicaoContainer" spacing="0"/>
                </ScrollPane>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnCriar" text="Criar Produto Final" onAction="#handleCriar" styleClass="btn-modal-submit"/>
    </HBox>
</VBox>
