<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.encomenda.ConfirmarCancelarEncomendaClienteModalController"
      styleClass="modal-root" prefWidth="420">

    <stylesheets>
        <String fx:value="/styles/encomenda.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Cancelar Encomenda" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2a-alert-circle-outline" iconSize="48" styleClass="estado-cancelada"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="form-label"
               text="Tem a certeza que pretende cancelar esta encomenda?"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="celula-dados"
               text="Esta ação não pode ser revertida."/>
        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"/>
    </VBox>

    <HBox styleClass="modal-footer" spacing="12">
        <Button fx:id="btnCancelar" text="Voltar" onAction="#handleCancelar" styleClass="btn-secundario"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfirmar" text="Cancelar Encomenda" onAction="#handleConfirmar" styleClass="button, danger"/>
    </HBox>

</VBox>
