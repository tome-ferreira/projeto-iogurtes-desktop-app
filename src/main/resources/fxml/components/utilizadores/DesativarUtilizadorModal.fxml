<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.utilizadores.DesativarUtilizadorModalController"
      styleClass="modal-root" prefWidth="420">

    <stylesheets>
        <String fx:value="/styles/utilizadores.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Desativar Utilizador" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" spacing="16">
        <Label fx:id="lblMensagem" wrapText="true" styleClass="form-label"/>
        <Label fx:id="lblErro" styleClass="form-error" wrapText="true" visible="true" managed="true" minHeight="32"/>
    </VBox>

    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnDesativar" text="Desativar" defaultButton="true" onAction="#handleDesativar" styleClass="btn-modal-submit-danger"/>
    </HBox>
</VBox>
