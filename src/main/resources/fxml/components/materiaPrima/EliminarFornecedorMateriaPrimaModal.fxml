<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.materiaPrima.EliminarFornecedorMateriaPrimaModalController"
      styleClass="modal-root" prefWidth="400">

    <stylesheets>
        <String fx:value="/styles/materiaPrima.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Remover Fornecedor" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2a-alert-circle-outline" iconSize="48" styleClass="cert-eliminar-icone"/>
        <Label fx:id="lblMensagem" wrapText="true" styleClass="cert-eliminar-mensagem"/>
        <Label text="Esta ação não pode ser desfeita." wrapText="true" styleClass="cert-eliminar-aviso"/>
        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"
               visible="false" managed="false"/>
    </VBox>

    <HBox styleClass="modal-footer">
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnConfirmar" text="Confirmar" onAction="#handleConfirmar"
                styleClass="btn-modal-submit-danger"/>
    </HBox>

</VBox>
