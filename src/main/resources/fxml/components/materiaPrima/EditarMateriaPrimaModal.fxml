<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.materiaPrima.EditarMateriaPrimaModalController"
      styleClass="modal-root" prefWidth="450">

    <stylesheets>
        <java.lang.String fx:value="/styles/materiaPrima.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Editar Matéria Prima" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content">
        <VBox styleClass="form-group">
            <Label text="Nome*" styleClass="form-label"/>
            <TextField fx:id="txtNome" promptText="Nome da matéria prima" styleClass="form-control"/>
        </VBox>

        <VBox styleClass="form-group">
            <Label text="Unidade" styleClass="form-label"/>
            <TextField fx:id="txtUnidade" promptText="ex: kg, L, un" styleClass="form-control"/>
        </VBox>

        <VBox styleClass="form-group">
            <Label text="Stock Mínimo*" styleClass="form-label"/>
            <TextField fx:id="txtStockMinimo" promptText="0.0" styleClass="form-control"/>
        </VBox>

        <VBox styleClass="form-group">
            <Label text="Tipo de Matéria Prima*" styleClass="form-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblTipoNome" styleClass="tipo-selecionado-nome" visible="false" managed="false" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnSelecionarTipo" text="Selecionar Tipo" onAction="#handleSelecionarTipo" styleClass="btn-selecionar-tipo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>

        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"/>
    </VBox>

    <HBox styleClass="modal-footer">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
