<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.tipoPallet.CriarTipoPalletModalController"
      styleClass="modal-root" prefWidth="400">

    <stylesheets>
        <String fx:value="/styles/tipoPallet.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Criar Tipo de Pallet" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content">
        <VBox styleClass="form-group">
            <Label text="Nome" styleClass="form-label"/>
            <TextField fx:id="txtNome" styleClass="form-control" promptText="Ex: Pallet Euro"/>
        </VBox>

        <VBox styleClass="form-group">
            <Label text="Capacidade (Kg)" styleClass="form-label"/>
            <TextField fx:id="txtCapacidade" styleClass="form-control" promptText="Ex: 1500"/>
        </VBox>

        <Label fx:id="lblErro" styleClass="form-error" wrapText="true"/>
    </VBox>

    <HBox styleClass="modal-footer">
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnCriar" text="Criar" defaultButton="true" onAction="#handleCriar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
