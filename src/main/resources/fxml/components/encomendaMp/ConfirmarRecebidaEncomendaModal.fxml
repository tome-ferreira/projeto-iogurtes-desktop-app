<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.encomendaMp.ConfirmarRecebidaEncomendaModalController"
      styleClass="modal-root" prefWidth="420">

    <stylesheets>
        <String fx:value="/styles/encomendaMp.css"/>
    </stylesheets>

    <HBox styleClass="modal-header">
        <Label text="Confirmar Receção" styleClass="modal-title"/>
    </HBox>

    <VBox styleClass="modal-content" alignment="CENTER" spacing="16">
        <FontIcon iconLiteral="mdi2p-package-variant-closed" iconSize="48" styleClass="confirmar-icone-sucesso"/>
        <Label wrapText="true" textAlignment="CENTER" styleClass="confirmar-mensagem"
               text="Confirma que esta encomenda foi recebida?"/>
        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"/>
    </VBox>

    <HBox styleClass="modal-footer" spacing="12">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnConfirmar" text="Marcar como Recebida" onAction="#handleConfirmar" styleClass="btn-modal-submit"/>
    </HBox>

</VBox>
