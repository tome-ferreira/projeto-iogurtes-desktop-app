<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.encomendaMp.DetalhesEncomendaMpModalController"
      styleClass="modal-root" prefWidth="620" prefHeight="580">

    <stylesheets>
        <String fx:value="/styles/encomendaMp.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Detalhe da Encomenda" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo em scroll principal -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox styleClass="modal-content" spacing="12">

            <!-- Bloco de informação geral -->
            <VBox styleClass="detalhe-info-block" spacing="8">

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Fornecedor:" styleClass="detalhe-label"/>
                    <Label fx:id="lblFornecedor" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Estado:" styleClass="detalhe-label"/>
                    <Label fx:id="lblEstado" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Data Encomenda:" styleClass="detalhe-label"/>
                    <Label fx:id="lblData" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Entrega Prevista:" styleClass="detalhe-label"/>
                    <Label fx:id="lblEntregaPrevista" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Moeda:" styleClass="detalhe-label"/>
                    <Label fx:id="lblMoeda" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Total s/ IVA (€):" styleClass="detalhe-label"/>
                    <Label fx:id="lblTotalSemIva" styleClass="detalhe-valor"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Total c/ IVA (€):" styleClass="detalhe-label"/>
                    <Label fx:id="lblTotalComIva" styleClass="detalhe-valor detalhe-valor-destaque"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Observações:" styleClass="detalhe-label"/>
                    <Label fx:id="lblObservacoes" styleClass="detalhe-valor" wrapText="true"/>
                </HBox>

            </VBox>

            <Separator/>

            <!-- Linhas da encomenda -->
            <Label text="LINHAS DA ENCOMENDA" styleClass="detalhe-secao-titulo"/>

            <VBox fx:id="linhasContainer" spacing="0"/>

        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <!-- Botão Cancelar (visível para PENDENTE e ENCOMENDADA) -->
        <Button fx:id="btnCancelarEncomenda"
                text="Cancelar Encomenda"
                onAction="#handleCancelarEncomenda"
                styleClass="btn-modal-submit-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Botão Aprovar — visível apenas para PENDENTE -->
        <Button fx:id="btnAprovar"
                text="Aprovar e Encomendar"
                onAction="#handleAprovar"
                styleClass="btn-modal-submit"/>
        <!-- Botão Recebida — visível apenas para ENCOMENDADA -->
        <Button fx:id="btnRecebida"
                text="Marcar como Recebida"
                onAction="#handleRecebida"
                styleClass="btn-modal-submit"/>
        <!-- Fechar — sempre visível -->
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-cancel"/>
    </HBox>

</VBox>
