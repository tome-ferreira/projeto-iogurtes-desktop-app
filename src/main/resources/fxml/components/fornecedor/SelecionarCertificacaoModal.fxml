<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.fornecedor.SelecionarCertificacaoModalController"
      styleClass="modal-root" prefWidth="480" prefHeight="480"
      maxHeight="-Infinity">

    <stylesheets>
        <String fx:value="/styles/fornecedor.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Adicionar Certificação" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content" spacing="12">

        <!-- Paginação da lista de certificações -->
        <HBox styleClass="selecionar-tipo-pagination" alignment="CENTER" spacing="12">
            <Button fx:id="btnAnterior" text="Anterior" onAction="#handleAnterior"
                    styleClass="btn-pagination" disable="true"/>
            <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"
                   HBox.hgrow="ALWAYS" alignment="CENTER"/>
            <Button fx:id="btnProximo" text="Próximo" onAction="#handleProximo"
                    styleClass="btn-pagination"/>
        </HBox>

        <!-- Loading inline -->
        <HBox fx:id="hboxLoading" styleClass="selecionar-tipo-loading"
              alignment="CENTER" spacing="8" visible="false" managed="false">
            <ProgressIndicator styleClass="loading-spinner" prefWidth="24" prefHeight="24"/>
            <Label text="A carregar..." styleClass="loading-label"/>
        </HBox>

     
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    maxHeight="220" prefHeight="220"
                    styleClass="cert-scroll">
            <VBox fx:id="listaContainer" styleClass="selecionar-tipo-lista" spacing="0"/>
        </ScrollPane>

        <!-- Secção de datas — sempre visível abaixo da lista -->
        <HBox spacing="16">
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Data de Início*" styleClass="form-label"/>
                <DatePicker fx:id="dpDataInicio" styleClass="form-control" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                <Label text="Data de Fim*" styleClass="form-label"/>
                <DatePicker fx:id="dpDataFim" styleClass="form-control" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <!-- Label de erro com altura reservada -->
        <Label fx:id="lblErro" styleClass="form-error" text="" wrapText="true"/>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnAdicionar" text="Adicionar" defaultButton="true"
                onAction="#handleAdicionar" styleClass="btn-modal-submit" disable="true"/>
    </HBox>

</VBox>
