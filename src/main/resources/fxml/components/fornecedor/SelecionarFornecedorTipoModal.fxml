<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.fornecedor.SelecionarFornecedorTipoModalController"
      styleClass="modal-root" prefWidth="500" prefHeight="550">
    <stylesheets>
        <String fx:value="/styles/fornecedor.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header">
        <Label text="Selecione o Tipo de Fornecedor" styleClass="modal-title"/>
    </HBox>

    <!-- Conteúdo -->
    <VBox styleClass="modal-content" spacing="12">
        <!-- Controles de paginação -->
        <HBox styleClass="selecionar-tipo-pagination" alignment="CENTER" spacing="12">
            <Button fx:id="btnAnterior" text="Anterior" onAction="#handleAnterior"
                    styleClass="btn-pagination" disable="true"/>
            <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"
                   HBox.hgrow="ALWAYS" alignment="CENTER"/>
            <Button fx:id="btnProximo" text="Próximo" onAction="#handleProximo"
                    styleClass="btn-pagination"/>
        </HBox>

        <!-- Indicador de loading inline -->
        <HBox fx:id="hboxLoading" styleClass="selecionar-tipo-loading"
              alignment="CENTER" spacing="8" visible="false" managed="false">
            <ProgressIndicator styleClass="loading-spinner" prefWidth="24" prefHeight="24"/>
            <Label text="A carregar..." styleClass="loading-label"/>
        </HBox>

        <!-- Lista de tipos (linhas injectadas dinamicamente) -->
        <VBox fx:id="listaContainer" styleClass="selecionar-tipo-lista" spacing="0"/>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer">
        <Button text="Cancelar" onAction="#handleCancelar" styleClass="btn-modal-cancel"/>
        <Button fx:id="btnContinuar" text="Continuar" defaultButton="true" onAction="#handleContinuar" styleClass="btn-modal-submit" disable="true"/>
    </HBox>
</VBox>
