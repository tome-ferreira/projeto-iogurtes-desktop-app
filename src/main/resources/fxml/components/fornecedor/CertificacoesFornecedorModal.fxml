<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestaoiogurtes.components.fornecedor.CertificacoesFornecedorModalController"
      styleClass="modal-root" prefWidth="780" prefHeight="540"
      maxHeight="-Infinity">

    <stylesheets>
        <String fx:value="/styles/fornecedor.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="lblTitulo" text="Certificações" styleClass="modal-title"
               maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdicionarCertificacao" text="Adicionar Certificação"
                onAction="#handleAdicionarCertificacao"
                styleClass="btn-modal-submit"/>
    </HBox>

    <!-- Barra de paginação — sempre visível, acima da lista -->
    <HBox styleClass="cert-pagination-bar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
        <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAnterior" text="Anterior" onAction="#handleAnterior"
                styleClass="btn-pagination" disable="true">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="16"/></graphic>
        </Button>
        <Button fx:id="btnProximo" text="Próximo" contentDisplay="RIGHT"
                onAction="#handleProximo" styleClass="btn-pagination">
            <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="16"/></graphic>
        </Button>
    </HBox>

    <!--
        Área de conteúdo: ScrollPane com altura máxima fixa → a lista nunca
        cresce além de 340 px e não empurra header/footer para fora do modal.
    -->
    <StackPane VBox.vgrow="ALWAYS">

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="cert-scroll"
                    VBox.vgrow="ALWAYS">
            <VBox fx:id="listaContainer" VBox.vgrow="ALWAYS">
                <padding><Insets top="0" right="24" bottom="8" left="24"/></padding>
            </VBox>
        </ScrollPane>

        <!-- Loading overlay — cobre apenas a área de scroll -->
        <VBox fx:id="loadingOverlay" styleClass="loading-overlay"
              alignment="CENTER" visible="false" managed="false">
            <ProgressIndicator styleClass="loading-spinner"/>
            <Label text="A carregar..." styleClass="loading-label"/>
        </VBox>

    </StackPane>

    <!-- Footer — fixo no fundo -->
    <HBox styleClass="modal-footer">
        <Button text="Fechar" onAction="#handleFechar" styleClass="btn-modal-cancel"/>
    </HBox>

</VBox>
