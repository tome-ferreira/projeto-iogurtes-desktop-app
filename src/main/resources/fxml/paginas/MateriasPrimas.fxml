<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Tooltip?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.MateriasPrimasController">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <!-- Wrapper da página com scroll -->
        <VBox styleClass="pagina-conteudo" VBox.vgrow="ALWAYS">
            <stylesheets>
                <String fx:value="/styles/materiaPrima.css"/>
            </stylesheets>
            
            <!-- Header HBox: title left + button right -->
            <HBox styleClass="pagina-cabecalho">
                <VBox spacing="4">
                    <Label text="Matérias Primas" styleClass="pagina-titulo"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNovo" text="Criar Matéria Prima" onAction="#handleNovo" textFill="WHITE" styleClass="btn-primario-cabecalho">
                    <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="16" iconColor="white"/></graphic>
                </Button>
            </HBox>

            <HBox styleClass="pagina-separador">
                <Region HBox.hgrow="ALWAYS" style="-fx-border-color: transparent transparent -color-border-subtle transparent; -fx-border-width: 0 0 1 0;" minHeight="1"/>
            </HBox>

            <StackPane fx:id="rootStack" VBox.vgrow="ALWAYS">
                <VBox VBox.vgrow="ALWAYS">
                    <padding><Insets top="0" right="32" bottom="32" left="32"/></padding>
                    <!-- Filter + Pagination HBox -->
                    <HBox styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"/>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                        
                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="btnAnterior" text="Anterior" onAction="#handlePaginaAnterior" styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="18"/></graphic>
                            </Button>
                            <Label text="Linhas por página:" styleClass="pagination-label"/>
                            <ComboBox fx:id="cbTamanhoPagina" styleClass="pagination-combo"/>
                            <Button fx:id="btnProxima" text="Próxima" contentDisplay="RIGHT" onAction="#handleProximaPagina" styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="18"/></graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- Wrapper da tabela -->
                    <VBox VBox.vgrow="ALWAYS">
                        <!-- TableView VBox -->
                        <VBox fx:id="tabelaContainer" styleClass="tabela-card" fillWidth="true" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <!-- Overlay de loading -->
                <VBox fx:id="loadingOverlay" styleClass="loading-overlay" alignment="CENTER" visible="false" managed="false">
                    <ProgressIndicator styleClass="loading-spinner"/>
                    <Label text="A carregar matérias primas..." styleClass="loading-label"/>
                </VBox>

                <!-- FAB -->
            </StackPane>
        </VBox>
    </center>
</BorderPane>
