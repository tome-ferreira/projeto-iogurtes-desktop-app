<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.chart.PieChart?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.DashboardFuncionarioMp">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <StackPane fx:id="rootStack">
            <VBox spacing="32">
                <stylesheets>
                    <String fx:value="/styles/dashboardFuncionarioMp.css"/>
                </stylesheets>
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <Label fx:id="greetingLabel" styleClass="title-2"/>

                <HBox spacing="16" maxWidth="Infinity">
                    <!-- Encomendas MP Pendentes -->
                    <VBox fx:id="cardPendentes" styleClass="stat-card, stat-card-pendentes" HBox.hgrow="ALWAYS">
                        <Label text="Encomendas MP Pendentes" styleClass="role-title"/>
                        <StackPane>
                            <ProgressIndicator fx:id="loadingPendentes" styleClass="loading-spinner"/>
                            <Label fx:id="countPendentes" text="..." styleClass="role-count"/>
                        </StackPane>
                    </VBox>

                    <!-- Encomendas MP em Trânsito -->
                    <VBox fx:id="cardEmTransito" styleClass="stat-card, stat-card-em-transito" HBox.hgrow="ALWAYS">
                        <Label text="Encomendas MP em Trânsito" styleClass="role-title"/>
                        <StackPane>
                            <ProgressIndicator fx:id="loadingEmTransito" styleClass="loading-spinner"/>
                            <Label fx:id="countEmTransito" text="..." styleClass="role-count"/>
                        </StackPane>
                    </VBox>

                    <!-- Alertas de Stock Baixo -->
                    <VBox fx:id="cardAlertas" styleClass="stat-card, stat-card-alertas" HBox.hgrow="ALWAYS">
                        <Label text="Alertas de Stock Baixo" styleClass="role-title"/>
                        <StackPane>
                            <ProgressIndicator fx:id="loadingAlertas" styleClass="loading-spinner"/>
                            <Label fx:id="countAlertas" text="..." styleClass="role-count"/>
                        </StackPane>
                    </VBox>
                </HBox>

                <HBox spacing="16" HBox.hgrow="ALWAYS" minHeight="280">
                    <!-- Pie chart card: ~60% width -->
                    <VBox fx:id="pieChartCard" styleClass="dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0">
                        <Label text="Matérias Primas por Tipo" styleClass="card-title"/>
                        <StackPane VBox.vgrow="ALWAYS">
                            <ProgressIndicator fx:id="loadingPieChart"/>
                            <PieChart fx:id="pieChartMaterias" prefHeight="260"
                                      labelsVisible="true" legendVisible="true" legendSide="RIGHT"/>
                        </StackPane>
                    </VBox>

                    <!-- Quick actions card: ~40% width -->
                    <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0" maxWidth="400">
                        <Label text="Ações Rápidas" styleClass="card-title"/>
                        <VBox spacing="12" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                            <padding><Insets top="16"/></padding>
                            <Button text="Gerir Encomendas de Matérias Primas" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToEncomendaMp"/>
                            <Button text="Lista de Matérias Primas" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToMateriasPrimas"/>
                            <Button text="Lista de Fornecedores" maxWidth="Infinity" styleClass="btn-acao-rapida" onAction="#handleNavigateToFornecedores"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
