<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Dashboard page.
  - Left  : Sidebar (included via fx:include — controller injected as sidebarController)
  - Center: Simple VBox with the "Dashboard" heading
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.paginas.Dashboard">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="16">
            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
            <Label text="Dashboard" styleClass="title-2"/>
        </VBox>
    </center>

</BorderPane>
