<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.EncomendaController">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="pagina-conteudo" VBox.vgrow="ALWAYS">
            <stylesheets>
                <String fx:value="/styles/encomenda.css"/>
            </stylesheets>

            <!-- 1. Header HBox -->
            <HBox styleClass="pagina-cabecalho" maxWidth="Infinity">
                <Label text="Encomendas de Clientes" styleClass="pagina-titulo"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Separator styleClass="pagina-separador"/>

            <StackPane fx:id="rootStack" VBox.vgrow="ALWAYS">
                <VBox VBox.vgrow="ALWAYS">
                    <padding><Insets top="0" right="32" bottom="32" left="32"/></padding>
                    
                    <!-- 2. Filter + Pagination HBox -->
                    <HBox styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="pagination-label"/>
                        
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Estado:" styleClass="pagination-label"/>
                            <ComboBox fx:id="cbFiltroEstado" styleClass="pagination-combo" promptText="Todos os Estados"/>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                        
                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="btnAnterior" text="Anterior" onAction="#handlePaginaAnterior" styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-left" iconSize="18"/></graphic>
                            </Button>
                            <Label text="Linhas por página:" styleClass="pagination-label"/>
                            <ComboBox fx:id="cbTamanhoPagina" styleClass="pagination-combo"/>
                            <Button fx:id="btnProxima" text="Próxima" contentDisplay="RIGHT" onAction="#handleProximaPagina" styleClass="btn-pagination">
                                <graphic><FontIcon iconLiteral="mdi2c-chevron-right" iconSize="18"/></graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- 3. TableView VBox.vgrow="ALWAYS" -->
                    <VBox fx:id="tabelaContainer"
                          styleClass="tabela-card"
                          fillWidth="true"
                          VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Loading overlay -->
                <VBox fx:id="loadingOverlay"
                      styleClass="loading-overlay"
                      alignment="CENTER"
                      visible="false" managed="false">
                    <ProgressIndicator styleClass="loading-spinner"/>
                    <Label text="A carregar..." styleClass="loading-label"/>
                </VBox>

            </StackPane>
        </VBox>
    </center>
</BorderPane>
