<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<!--
  Página de Stock.
  Para já em branco, apenas com o título.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestaoiogurtes.controllers.StockController">

    <left>
        <fx:include fx:id="sidebar" source="/fxml/layout/Sidebar.fxml"/>
