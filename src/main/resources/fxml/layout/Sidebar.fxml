<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root"
      fx:controller="com.gestaoiogurtes.layout.Sidebar"
      prefWidth="240" minWidth="58"
      styleClass="sidebar-root">

    <stylesheets>
        <String fx:value="/styles/sidebar.css"/>
    </stylesheets>

    <!-- ── Cabeçalho ───────────────────────── -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-header">
        <padding><Insets top="16" right="10" bottom="16" left="14"/></padding>

        <FontIcon iconLiteral="mdi2s-snowflake" iconSize="22" styleClass="accent"/>

        <Label fx:id="tituloLabel" text="Norgurtes"
               maxWidth="Infinity" HBox.hgrow="ALWAYS"
               styleClass="title-4, accent"/>

        <Button fx:id="btnToggle"
                styleClass="sidebar-toggle, button-circle, flat"
                onAction="#handleToggle">
            <graphic>
                <FontIcon iconLiteral="mdi2c-chevron-left" iconSize="16"/>
            </graphic>
            <tooltip>
                <Tooltip text="Recolher menu"/>
            </tooltip>
        </Button>
    </HBox>

    <Separator/>

    <!-- ── Navegação ───────────────────────── -->
    <VBox spacing="2" VBox.vgrow="ALWAYS">
        <padding><Insets top="8" right="6" bottom="8" left="6"/></padding>

        <Label text="MENU" styleClass="sidebar-section-label">
            <padding><Insets top="8" right="8" bottom="4" left="8"/></padding>
        </Label>

        <!-- Dashboard -->
        <Button fx:id="btnDashboard" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleDashboard">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2h-home-outline" iconSize="18"/>
                    <Label text="Dashboard" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Dashboard"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Empresas -->
        <Button fx:id="btnEmpresas" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleEmpresas">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2b-bank-outline" iconSize="18"/>
                    <Label text="Empresas" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Empresas"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Encomendas -->
        <Button fx:id="btnEncomendas" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleEncomendas">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2c-cart-outline" iconSize="18"/>
                    <Label text="Encomendas" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Encomendas"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Encomendas MP -->
        <Button fx:id="btnEncomendasMp" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleEncomendasMp">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2s-store-outline" iconSize="18"/>
                    <Label text="Encomendas MP" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Encomendas de Matéria Prima"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Ordens de Produção -->
        <Button fx:id="btnOrdensProducao" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleOrdensProducao">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2f-factory" iconSize="18"/>
                    <Label text="Ordens de Produção" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Ordens de Produção"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Fornecedores -->
        <Button fx:id="btnFornecedores" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleFornecedores">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2t-truck-delivery-outline" iconSize="18"/>
                    <Label text="Fornecedores" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Fornecedores"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Matérias Primas -->
        <Button fx:id="btnMateriasPrimas" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleMateriasPrimas">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2c-corn" iconSize="18"/>
                    <Label text="Matérias Primas" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Matérias Primas"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Moedas -->
        <Button fx:id="btnMoedas" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleMoedas">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2c-currency-usd" iconSize="18"/>
                    <Label text="Moedas" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Moedas"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Utilizadores -->
        <Button fx:id="btnUtilizadores" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleUtilizadores">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2a-account-group" iconSize="18"/>
                    <Label text="Utilizadores" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Utilizadores"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Tipos de Fornecedor -->
        <Button fx:id="btnTiposFornecedor" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleTiposFornecedor">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2t-tag-outline" iconSize="18"/>
                    <Label text="Tipos de Fornecedor" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Tipos de Fornecedor"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Certificações -->
        <Button fx:id="btnCertificacoes" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleCertificacoes">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2c-certificate-outline" iconSize="18"/>
                    <Label text="Certificações" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Certificações"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Tipos de Matéria Prima -->
        <Button fx:id="btnTiposMateriaPrima" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleTiposMateriaPrima">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2l-leaf" iconSize="18"/>
                    <Label text="Tipos de Matéria Prima" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Tipos de Matéria Prima"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Tipos de Pallet -->
        <Button fx:id="btnTiposPallet" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleTiposPallet">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2p-package-variant-closed" iconSize="18"/>
                    <Label text="Tipos de Pallet" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Tipos de Pallet"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Produtos Finais -->
        <Button fx:id="btnProdutosFinais" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleProdutosFinais">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2i-ice-cream" iconSize="18"/>
                    <Label text="Produtos Finais" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Produtos Finais"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Stock -->
        <Button fx:id="btnStock" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleStock">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2p-package-variant" iconSize="18"/>
                    <Label text="Stock" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Gestão de Stock"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>
    </VBox>


    <!-- ── Rodapé ───────────────────────── -->
    <VBox spacing="2">
        <padding><Insets top="4" right="6" bottom="10" left="6"/></padding>

        <Separator/>

        <!-- Tema -->
        <Button fx:id="btnTema" styleClass="sidebar-item"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleTema">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2t-theme-light-dark" iconSize="18"/>
                    <Label text="Mudar tema" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip>
                <Tooltip fx:id="temaTooltip" text="Primer Light"/>
            </tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>

        <!-- Sair -->
        <Button fx:id="btnSair"
                styleClass="sidebar-item, sidebar-item-danger"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                contentDisplay="GRAPHIC_ONLY"
                onAction="#handleSair">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="mdi2l-logout" iconSize="18"/>
                    <Label text="Sair" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Sair"/></tooltip>
            <padding><Insets top="9" right="12" bottom="9" left="10"/></padding>
        </Button>
    </VBox>

</VBox>